#!/bin/sh
# printpapi git hook: checks the docs before every push (see tools/docs/push_hook.py).
# Turn it on once per clone:  git config core.hooksPath tools/githooks
# git calls it at the real push with the remote name and URL as arguments and the pushed refs on
# stdin (https://git-scm.com/docs/githooks#_pre_push); a non-zero exit aborts the push.
# Without Python, or without the script in this checkout, it lets the push through.
py=$(command -v python || command -v python3) || exit 0
top=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$top" || exit 0
[ -f tools/docs/push_hook.py ] || exit 0
exec "$py" tools/docs/push_hook.py "$@"
