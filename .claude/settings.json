{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash,PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/tools/docs/push_hook.py\"; [ -f \"$f\" ] || exit 0; \"$(command -v python || command -v python3)\" \"$f\"",
            "onFailure": "continue",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
